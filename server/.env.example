# Backend portu
PORT=5001

# Frontend origin (CORS icin)
CLIENT_URL=http://localhost:5173

# OpenAI API key (SADECE backend'de kullanilir - ASLA frontend'e gonderilmez)
OPENAI_API_KEY=

# Kullanilacak OpenAI modeli
OPENAI_MODEL=gpt-4o-mini

# LLM saglayicisi (su an sadece "openai" implement edildi; bkz. llm/index.js)
LLM_PROVIDER=openai

# Supabase (SADECE backend) - service role key gizli kalmalidir, frontend'e GITMEZ
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Stripe (SADECE TEST MODE) - sk_test_... kullanin, ASLA sk_live_ degil
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
CLIENT_APP_URL=http://localhost:5173

# Calisma ortami
NODE_ENV=development

# GET /api/admin/ai-usage erisimi icin virgulle ayrilmis e-posta listesi.
# Bos birakilirsa admin endpoint'leri 403 doner (varsayilan kapali).
ADMIN_EMAILS=
